artifact "Paper Linked Marks"

data rows = [
  { t: 1, score: 8, arm: "placebo", ux: 0.2, uy: 0.8 }
  { t: 2, score: 14, arm: "placebo", ux: 0.4, uy: 0.4 }
  { t: 3, score: 20, arm: "placebo", ux: 0.6, uy: 0.1 }
  { t: 1, score: 18, arm: "drug-A", ux: 0.3, uy: 0.7 }
  { t: 2, score: 22, arm: "drug-A", ux: 0.5, uy: 0.5 }
  { t: 3, score: 26, arm: "drug-A", ux: 0.8, uy: 0.2 }
  { t: 1, score: 10, arm: "drug-B", ux: 0.1, uy: 0.6 }
  { t: 2, score: 16, arm: "drug-B", ux: 0.2, uy: 0.3 }
  { t: 3, score: 12, arm: "drug-B", ux: 0.4, uy: 0.2 }
]

scene
  unit: mm
  column: double
  height: 110
  background: #ffffff

widget layout.figure
  title: "Linked marks · brush a visit"
  subtitle: "heat / box / vector follow the same __sel"
  cols: 2
  rows: 2

widget chart.scatter
  panel: a
  data: rows
  xField: t
  yField: score
  group: arm
  xlim: 0 4
  ylim: 6 28
  xLabel: Visit
  yLabel: Score

widget chart.heatmap
  panel: b
  data: rows
  xField: t
  yField: arm
  valueField: score
  yScale: band
  xlim: 0 4
  zlim: 6 28
  zLabel: Score
  xLabel: Visit
  yLabel: Arm

widget chart.box
  panel: c
  data: rows
  xField: arm
  yField: score
  ylim: 6 28
  xLabel: Arm
  yLabel: Score

widget chart.vector
  panel: d
  data: rows
  xField: t
  yField: score
  uField: ux
  vField: uy
  group: arm
  xlim: 0 4
  ylim: 6 28
  xLabel: Visit
  yLabel: Score
