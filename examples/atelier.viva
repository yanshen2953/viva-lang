artifact "Atelier"

state selected = none
state pulse = 0
state motto = "图层 · 渐变 · 光晕 · 排版"

data orbs = [
  { name: "Aurora", x: 180, y: 250, r: 46, c1: "#38bdf8", c2: "#a78bfa" }
  { name: "Ember", x: 340, y: 210, r: 38, c1: "#fb7185", c2: "#f59e0b" }
  { name: "Moss", x: 280, y: 340, r: 42, c1: "#34d399", c2: "#22d3ee" }
]

data cards = [
  { title: "Gradient", body: "双色渐变填充", x: 560, y: 120 }
  { title: "Glow", body: "外发光滤镜", x: 560, y: 220 }
  { title: "Type", body: "字重 / 字距 / 多行", x: 560, y: 320 }
]

scene
  size: 880 520
  background: #070b14

  layer atmosphere
    opacity: 1
    blend: normal
    node wash
      x: 0
      y: 0
      w: 880
      h: 520
      gradient: #070b14 #111827 #0b1220
      gradientDir: y

    node bloom
      x: 120
      y: 80
      r: 120
      gradient: #1d4ed8 #0ea5e9
      opacity: 0.35
      blur: 28
      blend: screen

    node bloom2
      x: 720
      y: 420
      r: 140
      gradient: #9f1239 #f59e0b
      opacity: 0.28
      blur: 36
      blend: screen

  layer stage
    opacity: 1
    node panel
      x: 48
      y: 88
      w: 460
      h: 360
      radius: 28
      gradient: #0f172a #111827
      stroke: #334155
      strokeWidth: 1
      shadow: 0 24 48
      shadowColor: #000000
      shadowOpacity: 0.55

    node frame
      x: 64
      y: 104
      w: 428
      h: 328
      radius: 22
      fill: #020617
      stroke: #1e293b
      strokeWidth: 1
      dash: 2 8
      opacity: 0.9

    for orb in orbs
      node orb as orbs
        x: orb.x
        y: orb.y
        r: orb.r
        gradient: orb.c1 orb.c2
        glow: 22
        glowColor: orb.c1
        stroke: #f8fafc
        strokeWidth: 1.5
        drag: true
        hoverFill: #f8fafc
        shadow: 0 18 28
        shadowColor: #020617

      node orbLabel as orbLabels
        x: orb.x
        y: orb.y + orb.r + 22
        text: orb.name
        font: 13
        fontWeight: 600
        letterSpacing: 1.2
        fill: #cbd5e1
        align: center

  layer typography
    opacity: 0.98
    node title
      x: 56
      y: 48
      text: "Viva Atelier"
      font: 34
      fontWeight: 700
      letterSpacing: 0.5
      fill: #f8fafc

    node subtitle
      x: 260
      y: 48
      text: motto
      font: 14
      fontWeight: 500
      letterSpacing: 1.5
      fill: #94a3b8

    node hint
      x: 56
      y: 480
      text: "拖动光球 · 点击右侧卡片 · 空格切换标语"
      font: 13
      fill: #64748b
      letterSpacing: 0.4

  layer cards
    opacity: 1
    blend: normal
    for card in cards
      node card as cards
        x: card.x
        y: card.y
        w: 260
        h: 78
        radius: 18
        gradient: #0f172a #1e293b
        stroke: #334155
        strokeWidth: 1
        shadow: 0 16 30
        shadowColor: #000000
        hoverFill: #1e293b

      node cardTitle as cardTitles
        x: card.x + 22
        y: card.y + 32
        text: card.title
        font: 18
        fontWeight: 700
        fill: #e2e8f0

      node cardBody as cardBodies
        x: card.x + 22
        y: card.y + 56
        text: card.body
        font: 13
        fill: #94a3b8
        letterSpacing: 0.3

    if selected != none
      node detail
        x: 560
        y: 430
        text: selected.title
        font: 22
        fontWeight: 700
        fill: #38bdf8
        glow: 10
        glowColor: #38bdf8

  layer accents
    opacity: 0.9
    blend: screen
    node sparkA
      x1: 90
      y1: 430
      x2: 470
      y2: 430
      stroke: #38bdf8
      strokeWidth: 2
      dash: 8 10
      opacity: 0.55

    node badge
      x: 790
      y: 36
      r: 10
      gradient: #f59e0b #fb7185
      glow: 14
      glowColor: #f59e0b

event click on cards
  selected = card
  motto = card.body

event drag on orbs
  orb.x = __event.x
  orb.y = __event.y
  if orb.x < 100
    orb.x = 100
  if orb.x > 460
    orb.x = 460
  if orb.y < 140
    orb.y = 140
  if orb.y > 400
    orb.y = 400

event key on scene
  if __event.key == " "
    motto = "精致不靠堆关键字，靠 Runtime 接线"
    pulse = pulse + 1

tick 12
  pulse = pulse + 0.02
  for orb in orbs
    orb.r = 36 + (pulse * 8) % 12

animate fade
  target: title
  from: 0
  to: 1
  duration: 900ms
