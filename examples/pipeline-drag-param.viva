artifact "Drag param lab"

state param = 0.5
state t = 0

data knob = { x: 100, y: 40 }
data series = [
  { t: 0, v: 0.5 }
]

scene
  size: 480 280
  background: #ffffff

  layer ui
    node handle as knob
      x: knob.x
      y: knob.y
      r: 8
      fill: #0072B2
      drag: true

event drag on knob
  knob.x = clamp(__event.x, 40, 200)
  param = (knob.x - 40) / 160

widget chart.line
  data: series
  xField: t
  yField: v
  xlim: 0 8
  ylim: -1 1
