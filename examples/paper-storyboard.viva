artifact "Paper Storyboard"

data rows = [
  { t: 1, score: 12, arm: "placebo" }
  { t: 2, score: 14, arm: "placebo" }
  { t: 3, score: 11, arm: "placebo" }
  { t: 1, score: 20, arm: "drug-A" }
  { t: 2, score: 22, arm: "drug-A" }
  { t: 3, score: 24, arm: "drug-A" }
  { t: 1, score: 16, arm: "drug-B" }
  { t: 2, score: 17, arm: "drug-B" }
  { t: 3, score: 15, arm: "drug-B" }
]

scene
  unit: mm
  column: double
  height: 103
  background: #ffffff

widget layout.board
  title: "16:9 mm storyboard · four beats"
  caption: "play cycles __beat · every shot stays brushable"
  beats: 4
  play: true
  playFps: 1
  guides: false

widget chart.scatter
  panel: beat0
  data: rows
  xField: t
  yField: score
  group: arm
  xlim: 0 4
  ylim: 8 28
  xLabel: Visit
  yLabel: Score

widget chart.line
  panel: beat1
  data: rows
  xField: t
  yField: score
  group: arm
  xlim: 0 4
  ylim: 8 28
  xLabel: Visit
  yLabel: Score

widget chart.box
  panel: beat2
  data: rows
  xField: arm
  yField: score
  ylim: 8 28
  xLabel: Arm
  yLabel: Score

widget chart.violin
  panel: beat3
  data: rows
  xField: arm
  yField: score
  ylim: 8 28
  xLabel: Arm
  yLabel: Score
