artifact "Science Studio"

state yaw = 0.65
state pitch = 0.35
state zoom = 1.15
state pcaMark = none
state hint = "handbook:dashboard · role/colorBy · 拖拽 PCA · 点选标记"

data bars = [
  { cat: 1, val: 42, grp: "A" }
  { cat: 2, val: 68, grp: "A" }
  { cat: 3, val: 55, grp: "B" }
  { cat: 4, val: 91, grp: "B" }
  { cat: 5, val: 73, grp: "C" }
]

data lineSeries = [
  { t: 0, v: 12, grp: "trend" }
  { t: 1, v: 18, grp: "trend" }
  { t: 2, v: 15, grp: "trend" }
  { t: 3, v: 28, grp: "trend" }
  { t: 4, v: 22, grp: "trend" }
  { t: 5, v: 35, grp: "trend" }
  { t: 6, v: 30, grp: "trend" }
]

data field = [
  { ox: 1, oy: 2, ux: 1.2, uy: 1.8, grp: "flow" }
  { ox: 2.5, oy: 3, ux: -0.8, uy: 2.4, grp: "flow" }
  { ox: 4, oy: 1.5, ux: 1.5, uy: -1.2, grp: "shear" }
  { ox: 5.5, oy: 4, ux: -1.1, uy: -1.6, grp: "shear" }
  { ox: 7, oy: 2.8, ux: 0.6, uy: 2.2, grp: "flow" }
  { ox: 8.2, oy: 5, ux: 1.8, uy: 0.9, grp: "curl" }
]

data pca = [
  { id: "A1", x: -1.4, y: 0.9, z: 0.4, grp: "A" }
  { id: "A2", x: -1.1, y: 0.6, z: 0.2, grp: "A" }
  { id: "A3", x: -0.9, y: 1.1, z: 0.5, grp: "A" }
  { id: "B1", x: 0.2, y: -0.3, z: 1.1, grp: "B" }
  { id: "B2", x: 0.5, y: -0.6, z: 0.9, grp: "B" }
  { id: "B3", x: 0.8, y: -0.2, z: 1.3, grp: "B" }
  { id: "C1", x: 1.2, y: 0.7, z: -0.8, grp: "C" }
  { id: "C2", x: 1.5, y: 1.0, z: -1.0, grp: "C" }
  { id: "C3", x: 1.0, y: 0.4, z: -0.6, grp: "C" }
]

frame quiver
  x: 528 752
  y: 318 488
  xlim: 0 10
  ylim: 0 7

scene
  size: 1180 720

  layer textureBackdrop
    blend: multiply
    node gridA
      role: atmosphere
      x: 0
      y: 0
      w: 1180
      h: 720
      gradient: #0a0f1a #0f172a #070b14
      gradientDir: y

  layer colorWash
    blend: soft-light
    node washL
      role: atmosphere
      x: 60
      y: 140
      r: 180
      gradient: #1d4ed8 #0ea5e9
      blur: 40
      opacity: 0.35

    node washR
      role: atmosphere
      x: 1020
      y: 500
      r: 200
      gradient: #be123c #f59e0b
      blur: 48
      opacity: 0.28

  layer charts
    node chartDeck
      role: panel
      x: 488
      y: 64
      w: 672
      h: 248
      radius: 18
      shadow: 0 18 36
      shadowOpacity: 0.45

    node vecDeck
      role: panel
      x: 488
      y: 328
      w: 296
      h: 248
      radius: 18

    node vecPlotBg
      role: plot
      x: 512
      y: 368
      w: 248
      h: 188
      radius: 8

    node vecTitle
      role: title
      x: 512
      y: 340
      text: "VECTOR FIELD"
      letterSpacing: 1

    node vecGrid1
      role: grid
      frame: quiver
      x1: 0
      y1: 1.75
      x2: 10
      y2: 1.75

    node vecGrid2
      role: grid
      frame: quiver
      x1: 0
      y1: 3.5
      x2: 10
      y2: 3.5

    node vecGrid3
      role: grid
      frame: quiver
      x1: 0
      y1: 5.25
      x2: 10
      y2: 5.25

    node vecAxisX
      role: axis
      frame: quiver
      x1: 0
      y1: 0
      x2: 10
      y2: 0

    node vecAxisY
      role: axis
      frame: quiver
      x1: 0
      y1: 0
      x2: 0
      y2: 7

    for v in field
      node vecShaft as vecLines
        role: mark-line
        frame: quiver
        x1: v.ox
        y1: v.oy
        x2: v.ox + v.ux
        y2: v.oy + v.uy
        colorBy: grp
        palette: categorical
        strokeWidth: 2.5

      node vecHead as vecHeads
        role: mark
        frame: quiver
        x: v.ox + v.ux
        y: v.oy + v.uy
        r: 4.5
        colorBy: grp
        palette: categorical

    node legFlow
      role: legend
      x: 528
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("flow", "categorical")
      styleSkip: true

    node legFlowLbl
      role: legend-label
      x: 544
      y: 558
      text: "flow"

    node legShear
      role: legend
      x: 600
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("shear", "categorical")
      styleSkip: true

    node legShearLbl
      role: legend-label
      x: 616
      y: 558
      text: "shear"

    node legCurl
      role: legend
      x: 672
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("curl", "categorical")
      styleSkip: true

    node legCurlLbl
      role: legend-label
      x: 688
      y: 558
      text: "curl"

  layer pca
    node pcaDeck
      role: panel
      x: 800
      y: 328
      w: 360
      h: 248
      radius: 18

    node pcaPlotBg
      role: plot
      x: 816
      y: 368
      w: 328
      h: 188
      radius: 8

    node pcaTitle
      role: title
      x: 816
      y: 340
      text: "PCA · 3D ORBIT"
      letterSpacing: 1

    node pcaOrbit
      role: chrome
      x: 816
      y: 368
      w: 328
      h: 188
      opacity: 0.03
      drag: true

    node pcaAxis
      role: axis
      x: 980
      y: 462
      w: 140
      h: 1.5
      opacity: 0.75

    node pcaAxisY
      role: axis
      x: 980
      y: 382
      w: 1.5
      h: 160
      opacity: 0.75

    for p in pca
      node pcaPt as pcaPts
        role: mark
        x: 980 + (p.x * cos(yaw) - p.z * sin(yaw)) * zoom * 78
        y: 462 - (p.y * cos(pitch) - (p.x * sin(yaw) + p.z * cos(yaw)) * sin(pitch)) * zoom * 78
        r: 8
        colorBy: grp
        palette: categorical
        glow: 8

      if pcaMark == p.id
        node pcaRing as pcaPts
          role: annotation
          x: 980 + (p.x * cos(yaw) - p.z * sin(yaw)) * zoom * 78
          y: 462 - (p.y * cos(pitch) - (p.x * sin(yaw) + p.z * cos(yaw)) * sin(pitch)) * zoom * 78
          r: 14
          opacity: 0.12
          strokeWidth: 2
          dash: 5 4

    node legA
      role: legend
      x: 824
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("A", "categorical")
      styleSkip: true

    node legALbl
      role: legend-label
      x: 840
      y: 558
      text: "cluster A"

    node legB
      role: legend
      x: 920
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("B", "categorical")
      styleSkip: true

    node legBLbl
      role: legend-label
      x: 936
      y: 558
      text: "cluster B"

    node legC
      role: legend
      x: 1016
      y: 548
      w: 10
      h: 10
      radius: 2
      fill: palette("C", "categorical")
      styleSkip: true

    node legCLbl
      role: legend-label
      x: 1032
      y: 558
      text: "cluster C"

    node zoomOut
      role: chrome
      x: 1110
      y: 336
      w: 30
      h: 30
      radius: 8

    node zoomIn
      role: chrome
      x: 1148
      y: 336
      w: 30
      h: 30
      radius: 8

    node zoomOutLbl
      role: label
      x: 1125
      y: 356
      text: "-"
      font: 20
      align: center

    node zoomInLbl
      role: label
      x: 1163
      y: 356
      text: "+"
      font: 20
      align: center

  layer typography
    node title
      role: title
      x: 48
      y: 56
      text: "图文排版 · 科学图板"
      font: 28

    node subtitle
      role: subtitle
      x: 48
      y: 96
      text: "handbook 驱动 · role / colorBy · 任意构图"

    node body1
      role: label
      x: 48
      y: 148
      w: 420
      text: "数据只写 grp；色板/框线/网格由 dashboard 预设注入。LLM 可用 node+frame 画任意图，不必依赖 chart 目录。"
      lineHeight: 1.55

    node caption
      role: caption
      x: 48
      y: 680
      text: hint

    if pcaMark != none
      node markLbl
        role: annotation
        x: 48
        y: 640
        text: pcaMark
        font: 16
        fontWeight: 600

  layer screenGlow
    blend: screen
    node topGlow
      role: atmosphere
      x: 520
      y: 0
      w: 480
      h: 100
      gradient: #38bdf8 #0ea5e9
      opacity: 0.18
      blur: 36

widget chart.bar
  data: bars
  xField: cat
  yField: val
  group: grp
  xlim: 0 6
  ylim: 0 100
  areaX: 508 688
  areaY: 108 268
  title: "BAR · by group"
  barWidth: 0.52

widget chart.line
  data: lineSeries
  xField: t
  yField: v
  group: grp
  xlim: 0 6
  ylim: 0 40
  areaX: 708 1148
  areaY: 108 268
  title: "LINE · trend"

event drag on pcaOrbit
  yaw = yaw + __event.dx * 0.012
  pitch = clamp(pitch - __event.dy * 0.012, -1.1, 1.1)

event click on pcaPts
  pcaMark = p.id

event click on zoomIn
  zoom = clamp(zoom + 0.12, 0.6, 2.2)

event click on zoomOut
  zoom = clamp(zoom - 0.12, 0.6, 2.2)

tick 30
  hint = "handbook:dashboard active"
