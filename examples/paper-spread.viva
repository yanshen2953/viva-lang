artifact "Paper Spread"

data left = [
  { x: 1, y: 12 }
  { x: 2, y: 18 }
  { x: 3, y: 16 }
  { x: 4, y: 24 }
]

data right = [
  { arm: "placebo", y: 12 }
  { arm: "placebo", y: 14 }
  { arm: "drug-A", y: 20 }
  { arm: "drug-A", y: 22 }
]

scene
  unit: mm
  page: a4
  column: double
  height: 120
  background: #ffffff

widget layout.figure
  title: "Double-column 183 mm on A4"
  cols: 2
  rows: 1

widget chart.line
  panel: a
  data: left
  xField: x
  yField: y
  xlim: 0 5
  ylim: 0 30
  xLabel: Visit
  yLabel: Score

widget chart.box
  panel: b
  data: right
  xField: arm
  yField: y
  ylim: 8 28
  xLabel: Arm
  yLabel: Score
