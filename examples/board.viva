artifact "Board"

data beats = [
  { x: 0, y: 12 }
  { x: 1, y: 18 }
  { x: 2, y: 15 }
  { x: 3, y: 24 }
  { x: 4, y: 20 }
]

scene
  size: 1280 720
  background: #0b1220

  layer copy
    node headline
      x: 80
      y: 110
      text: "16:9 board · title / body / lower"
      font: 28
      fill: #e2e8f0

    node lowerThird
      x: 80
      y: 640
      text: "Viva layout.board · no new keywords"
      font: 18
      fill: #94a3b8

widget layout.board
  w: 1280
  h: 720
  safe: 64
  titleH: 80
  lowerH: 96
  guides: true

widget chart.line
  panel: body
  data: beats
  xField: x
  yField: y
  xlim: 0 4
  ylim: 0 30
  xLabel: Beat
  yLabel: Level
  interactive: false
