artifact "Linked Summary"

data rows = [
  { t: 1, score: 12, arm: "placebo" }
  { t: 2, score: 14, arm: "placebo" }
  { t: 3, score: 11, arm: "placebo" }
  { t: 1, score: 20, arm: "drug-A" }
  { t: 2, score: 22, arm: "drug-A" }
  { t: 3, score: 24, arm: "drug-A" }
  { t: 1, score: 16, arm: "drug-B" }
  { t: 2, score: 17, arm: "drug-B" }
  { t: 3, score: 15, arm: "drug-B" }
]

scene
  size: 880 360
  background: #ffffff

widget layout.figure
  x: 16
  y: 16
  w: 848
  h: 328
  cols: 2
  rows: 1
  gutter: 28
  margin: 8
  insetL: 56
  insetR: 24
  insetT: 28
  insetB: 40

widget chart.scatter
  panel: a
  data: rows
  xField: t
  yField: score
  group: arm
  xlim: 0 4
  ylim: 8 28
  xLabel: Visit
  yLabel: Score
  title: "Brush a group"

widget chart.box
  panel: b
  data: rows
  xField: arm
  yField: score
  ylim: 8 28
  xLabel: Arm
  yLabel: Score
  title: "Box follows __sel"
